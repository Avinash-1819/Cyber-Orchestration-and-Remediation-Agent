# =============================================================================
# SENTINEL AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real values to version control.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
FRONTEND_URL=http://localhost:5173

# --- JWT Auth ---
# Leave blank on first boot — a secure random value will be auto-generated.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- GitHub OAuth2 ---
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# --- Gemini / Google AI ---
GEMINI_API_KEY=

# --- LLM Model Routing (override defaults here) ---
# Agents 4 & 6: deep reasoning, compliance, executive reporting
LLM_MODEL_PRO=gemini-2.5-pro
# Agents 1, 2, 3, 5: fast structured extraction
LLM_MODEL_FLASH=gemini-2.0-flash
# Orchestrator classification, pre-filtering
LLM_MODEL_FLASH_LITE=gemini-2.0-flash-lite

# --- External Intel APIs ---
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
NVD_API_KEY=

# --- Rate Limiting (Sentinel AI own API) ---
RATE_LIMIT_SCAN_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# --- Outbound Rate Limits (per-source request/window) ---
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
SHODAN_REQUESTS_PER_SECOND=1
NVD_REQUESTS_PER_30S=50

# --- Cache TTLs (seconds) ---
IOC_CACHE_TTL_SECONDS=86400       # 24 hours
CVE_CACHE_TTL_SECONDS=604800      # 7 days

# --- Reporting ---
REPORTS_OUTPUT_DIR=./data/reports

# --- MITRE ATT&CK ---
MITRE_DATA_PATH=./data/mitre/enterprise-attack.json

# --- Dev-only local auth bypass (set to false in production) ---
# When true, a local username/password login is available at /api/v1/auth/local
ENABLE_LOCAL_AUTH=true
