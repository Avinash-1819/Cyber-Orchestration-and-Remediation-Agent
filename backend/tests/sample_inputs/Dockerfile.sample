# Sample Dockerfile with security issues (for Pipeline A testing)
FROM ubuntu:14.04

# Running as root (no USER instruction)
RUN apt-get update && apt-get install -y python3 python3-pip

WORKDIR /app

# Copying everything including secrets
ADD . /app/

# Hardcoded secret in ENV
ENV DATABASE_PASSWORD=admin123
ENV API_KEY=sk-live-abc123def456

# Installing from requirements without pinned versions
RUN pip3 install -r requirements.txt

# Exposing unnecessary port
EXPOSE 22
EXPOSE 8000

# No HEALTHCHECK
CMD ["python3", "app.py"]
